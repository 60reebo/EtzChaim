{-# OPTIONS --no-main #-}

--------------------------------------------------
-- Math Ordinal (Domain/Math)
--------------------------------------------------
module Hishtalshelut.Domain.Math.Ordinal where

open import Agda.Primitive using (Level)

open import Agda.Builtin.String using (String)
import Data.String.Base as Str using (_++_)
open import Data.Nat using (ℕ; zero; suc)
open import Data.Bool using (Bool; true; false)
open import Data.Unit using (⊤ ; tt)
open import Relation.Binary.PropositionalEquality using (_≡_; refl; cong; trans; sym)
open Relation.Binary.PropositionalEquality.≡-Reasoning
open import Data.Product using (Σ; _,_)
open import Data.Maybe using (Maybe; nothing; just)

-- נוסיף import לפני פונקציית funExt
open import Relation.Binary.PropositionalEquality as Eq
open Eq.≡-Reasoning

-- | Function extensionality
postulate
  funExt : ∀ {ℓ ℓ'} {A : Set ℓ} {B : Set ℓ'} {f g : A → B} → (∀ x → f x ≡ g x) → f ≡ g

-- | Iterate f n times
iterate : ∀ {ℓ} {A : Set ℓ} → (A → A) → ℕ → A → A
iterate f zero x = x
iterate f (suc n) x = iterate f n (f x)

-- | Ordinal type: zero, successor, limit
data Ordinal (ℓ : Level) : Set ℓ where
  zero    : Ordinal ℓ
  succ    : Ordinal ℓ → Ordinal ℓ
  limit   : (ℕ → Ordinal ℓ) → Ordinal ℓ

-- | Helper to lift limit to be level-polymorphic
limit′ : ∀ {ℓ} → (ℕ → Ordinal ℓ) → Ordinal ℓ
limit′ {ℓ} f = limit f

-- | Ordinal addition
infixl 6 _+_
_+_ : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Ordinal ℓ
zero  + b = b
succ a + b = succ (a + b)
limit f + b = limit (λ n → f n + b)

-- | Ordinal multiplication
infixl 7 _*_
_*_ : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Ordinal ℓ
zero  * b = zero
succ a * b = b + (a * b)
limit f * b = limit (λ n → f n * b)

-- | Ordinal exponentiation
infixr 8 _^_
_^_ : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Ordinal ℓ
a ^ zero       = succ zero
a ^ (succ b)   = a * (a ^ b)
a ^ (limit f)  = limit (λ n → a ^ (f n))


-- דוגמאות לאורדינלים טרנספיניטיים
omega : ∀ {ℓ} → Ordinal ℓ
omega = limit (λ n → iterate succ n zero)

omega² : ∀ {ℓ} → Ordinal ℓ
omega² = limit (λ n → iterate (λ x → omega + x) n zero)

fromNatO : ∀ {ℓ} → ℕ → Ordinal ℓ
fromNatO n = iterate succ n zero

Omega : ∀ {ℓ} → Ordinal ℓ
Omega = limit (λ n → omega ^ succ (fromNatO n))

-- | Compare ordinals
ordinalEq : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Bool
ordinalEq zero zero = true
ordinalEq (succ a) (succ b) = ordinalEq a b
ordinalEq _ _ = false

-- | Predecessor for Ordinal (approximation)
predO : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ
predO zero      = zero
predO (succ o)  = o
predO (limit f) = limit (λ n → predO (f n))


-- | Show Ordinal as String
showOrdinal : ∀ {ℓ} → Ordinal ℓ → String
showOrdinal zero = "0"
showOrdinal (succ o) = Str._++_ "S(" (Str._++_ (showOrdinal o) ")")
showOrdinal (limit _) = "lim"

-- | האם אורדינל הוא limit (לא אפס ולא יורש)
isLimit : ∀ {ℓ} → Ordinal ℓ → Bool
isLimit zero = false
isLimit (succ _) = false
isLimit (limit _) = true

-- | האם אורדינל הוא סופי (קיים n:ℕ כך ש-o = fromNatO n)
isFinite : ∀ {ℓ} → Ordinal ℓ → Bool
isFinite zero = true
isFinite (succ o) = isFinite o
isFinite (limit _) = false

-- דוגמאות שימוש:
-- isLimit omega == true
-- isFinite (fromNatO 5) == true
-- isFinite omega == false

-- | Associativity of addition
assoc⁺ : ∀ {ℓ} (a b c : Ordinal ℓ) → (a + b) + c ≡ a + (b + c)
assoc⁺ zero b c = refl
assoc⁺ (succ a) b c = cong succ (assoc⁺ a b c)
assoc⁺ (limit f) b c = cong limit (funExt λ n → assoc⁺ (f n) b c)

-- | Distributivity of multiplication over addition
distrib*+ : ∀ {ℓ} (a b c : Ordinal ℓ) → (a + b) * c ≡ (a * c) + (b * c)
distrib*+ zero b c = refl
distrib*+ (succ a) b c =
  Relation.Binary.PropositionalEquality.trans
    (cong (λ x → c + x) (distrib*+ a b c))
    (Relation.Binary.PropositionalEquality.sym (assoc⁺ c (a * c) (b * c)))
distrib*+ (limit f) b c =
  cong limit (funExt (λ n → distrib*+ (f n) b c))

-- | Ordinal multiplication
assoc* : ∀ {ℓ} (a b c : Ordinal ℓ) → ((a * b) * c) ≡ (a * (b * c))
assoc* zero b c = refl
assoc* (succ a) b c =
  trans (cong (λ x → x * c) (cong (λ x → b + x) refl))
        (trans (distrib*+ b (a * b) c)
               (cong (λ x → (b * c) + x) (assoc* a b c)))
assoc* (limit f) b c = cong limit (funExt (λ n → assoc* (f n) b c))

-- Define the ordering relation ≤ on ordinals
infix 4 _≤_
data _≤_ {ℓ : Level} : Ordinal ℓ → Ordinal ℓ → Set ℓ where
  zero≤ : {b : Ordinal ℓ} → zero ≤ b
  suc≤  : {a b : Ordinal ℓ} → a ≤ b → succ a ≤ succ b
  supL  : {f : ℕ → Ordinal ℓ} {b : Ordinal ℓ} → (∀ n → f n ≤ b) → limit f ≤ b
  supR  : {a : Ordinal ℓ} {f : ℕ → Ordinal ℓ} → Σ ℕ (λ n → a ≤ f n) → a ≤ limit f

-- | Reflexivity and transitivity of ≤
refl≤ : ∀ {ℓ} {a : Ordinal ℓ} → a ≤ a
refl≤ {a = zero} = zero≤
refl≤ {a = succ a} = suc≤ refl≤
refl≤ {a = limit f} = supR (0 , supL (λ _ → refl≤))

trans≤ : ∀ {ℓ} {a b c : Ordinal ℓ} → a ≤ b → b ≤ c → a ≤ c
trans≤ zero≤ _ = zero≤
trans≤ (suc≤ a≤b) (suc≤ b≤c) = suc≤ (trans≤ a≤b b≤c)
trans≤ (supL ∀n→fn≤b) b≤c = supL (λ n → trans≤ (∀n→fn≤b n) b≤c)
trans≤ (supR (n , a≤fn)) (supL ∀n→fn≤c) = trans≤ a≤fn (∀n→fn≤c n)
trans≤ (supR (n , a≤fn)) (supR (m , b≤gm)) = supR (m , trans≤ a≤fn (b≤gm))

-- | Decidability postulate for the ordering relation
open import Relation.Nullary using (Dec; yes; no)

postulate
  decOrdLE : ∀ {ℓ} (a b : Ordinal ℓ) → Dec (a ≤ b)

-- | Decidable comparison function
_≤?_ : ∀ {ℓ} → (a b : Ordinal ℓ) → Dec (a ≤ b)
a ≤? b = decOrdLE a b

-- | Boolean version of ≤ (useful for computations)
ordLeq : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Bool
ordLeq a b with a ≤? b
... | yes _ = true
... | no _  = false

-- | Monotonicity postulates (keeping them postulated for now)
postulate
  monoLplus : ∀ {ℓ} → (x y z : Ordinal ℓ) → x ≤ y → (x + z) ≤ (y + z)
  -- mono*     : ∀ {ℓ} → (a b c : Ordinal ℓ) → b ≤ c → (a * b) ≤ (a * c)
  -- monoL*    : ∀ {ℓ} → (a b c : Ordinal ℓ) → a ≤ b → (a * c) ≤ (b * c)

-- | Postulate for bivariate monotonicity of addition
postulate
  +-mono : ∀ {ℓ} (x₁ y₁ x₂ y₂ : Ordinal ℓ) → x₁ ≤ y₁ → x₂ ≤ y₂ → (x₁ + x₂) ≤ (y₁ + y₂)

{- הערה: את הפוסטולטים האלה אפשר להוכיח באמצעות אינדוקציה מורכבת:

סקיצה של הוכחה עבור monoLplus:
1. במקרה של x = zero: כיוון ש-zero + z = z, ו-zero ≤ y, אז z ≤ y + z
2. במקרה של x = succ a ו-y = succ b: מניחים a ≤ b => a + z ≤ b + z, ומוכיחים succ(a + z) ≤ succ(b + z)
3. במקרה של x = limit f: מוכיחים שכל f n ≤ y => (f n) + z ≤ y + z ומזה limit f + z ≤ y + z
4. במקרה של y = limit g: מוכיחים שאם קיים n כך ש-x ≤ g n אז גם x + z ≤ (g n) + z

ההוכחות של mono* ו-monoL* דומות אבל דורשות עבודה עם ההגדרה הרקורסיבית של כפל אורדינלים.
-}

-- מקסימום של שני אורדינלים
maxO : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ → Ordinal ℓ
maxO zero b = b
maxO a zero = a
maxO (succ a) (succ b) = succ (maxO a b)
maxO (limit f) (limit g) = limit (λ n → maxO (f n) (g n))
maxO (succ a) (limit g) = limit (λ n → maxO (succ a) (g n))
maxO (limit f) (succ b) = limit (λ n → maxO (f n) (succ b))

-- פונקציה לסדרה עבור limit בקרדינלים אינסופיים
natTo : ∀ {ℓ} → ℕ → Ordinal ℓ → Ordinal ℓ → Ordinal ℓ
natTo n α β = maxO (fromNatO n) (maxO α β)

-- שאר המקרים (עם לפחות limit אחד) פוסטולטים
postulate
  assocMaxO-complex : ∀ {ℓ} (a b c : Ordinal ℓ) → maxO (maxO a b) c ≡ maxO a (maxO b c)
  limitNatToAssoc : ∀ {ℓ} (α β γ : Ordinal ℓ) →
    maxO (limit (λ m → natTo m α β)) γ ≡ maxO α (limit (λ m → natTo m β γ))

-- הוכחה רקורסיבית לאסוציאטיביות של maxO
assocMaxO : ∀ {ℓ} (a b c : Ordinal ℓ) → maxO (maxO a b) c ≡ maxO a (maxO b c)

-- מקרים פשוטים שמתוכיחים מיידית מהגדרת maxO
assocMaxO zero zero c = refl
assocMaxO zero (succ b) zero = refl
assocMaxO zero (succ b) (succ c) = refl
assocMaxO zero (succ b) (limit h) = refl
assocMaxO zero (limit g) zero = refl
assocMaxO zero (limit g) (succ c) = refl
assocMaxO zero (limit g) (limit h) = refl
assocMaxO (succ a) zero zero = refl
assocMaxO (succ a) zero (succ c) = refl
assocMaxO (succ a) zero (limit h) = refl
assocMaxO (limit f) zero zero = refl
assocMaxO (limit f) zero (succ c) = refl
assocMaxO (limit f) zero (limit h) = refl
assocMaxO (succ a) (succ b) zero = refl
assocMaxO (succ a) (limit g) zero = refl
assocMaxO (limit f) (succ b) zero = refl
assocMaxO (limit f) (limit g) zero = refl

-- המקרה של 3 successor הוא אינדוקטיבי
assocMaxO (succ a) (succ b) (succ c) = cong succ (assocMaxO a b c)

-- מקרים עם לפחות limit אחד - ניתן להוכיח באמצעות השוואה ישירה של ההגדרות
-- ושימוש ב-funExt
-- נשתמש בהוכחות רקורסיביות כרגע עבור המקרים החסרים

-- מקרה שבו הראשון והשלישי הם limit
assocMaxO (limit f) (succ b) (limit h) = 
  begin
    maxO (maxO (limit f) (succ b)) (limit h)
  ≡⟨⟩
    maxO (limit (λ n → maxO (f n) (succ b))) (limit h)
  ≡⟨⟩
    limit (λ n → maxO (maxO (f n) (succ b)) (h n))
  ≡⟨ cong limit (funExt (λ n → assocMaxO (f n) (succ b) (h n))) ⟩
    limit (λ n → maxO (f n) (maxO (succ b) (h n)))
  ≡⟨⟩
    maxO (limit f) (limit (λ n → maxO (succ b) (h n)))
  ≡⟨⟩
    maxO (limit f) (maxO (succ b) (limit h))
  ∎

-- מקרה שבו השני והשלישי הם limit
assocMaxO (succ a) (limit g) (limit h) =
  begin
    maxO (maxO (succ a) (limit g)) (limit h)
  ≡⟨⟩
    maxO (limit (λ n → maxO (succ a) (g n))) (limit h)
  ≡⟨⟩
    limit (λ n → maxO (maxO (succ a) (g n)) (h n))
  ≡⟨ cong limit (funExt (λ n → assocMaxO (succ a) (g n) (h n))) ⟩
    limit (λ n → maxO (succ a) (maxO (g n) (h n)))
  ≡⟨⟩
    maxO (succ a) (limit (λ n → maxO (g n) (h n)))
  ≡⟨⟩
    maxO (succ a) (maxO (limit g) (limit h))
  ∎

-- מקרה שבו כל הארגומנטים הם limit
assocMaxO (limit f) (limit g) (limit h) =
  begin
    maxO (maxO (limit f) (limit g)) (limit h)
  ≡⟨⟩
    maxO (limit (λ n → maxO (f n) (g n))) (limit h)
  ≡⟨⟩
    limit (λ n → maxO (maxO (f n) (g n)) (h n))
  ≡⟨ cong limit (funExt (λ n → assocMaxO (f n) (g n) (h n))) ⟩
    limit (λ n → maxO (f n) (maxO (g n) (h n)))
  ≡⟨⟩
    maxO (limit f) (limit (λ n → maxO (g n) (h n)))
  ≡⟨⟩
    maxO (limit f) (maxO (limit g) (limit h))
  ∎

-- יתר המקרים
assocMaxO (succ a) (succ b) (limit h) =
  begin
    maxO (maxO (succ a) (succ b)) (limit h)
  ≡⟨⟩
    maxO (succ (maxO a b)) (limit h)
  ≡⟨⟩
    limit (λ n → maxO (succ (maxO a b)) (h n))
  ≡⟨ cong limit (funExt (λ n → 
      let
        h-n-nonzero = h n -- הנחה שסדרת הגבול לא מכילה zero
        -- כאשר h n = zero: maxO (succ a') zero = succ a'
        -- כאשר h n = succ b', אז maxO (succ a') (succ b') = succ (maxO a' b')
      in 
        if isSucc (h n) then
          cong succ (maxSuccAssoc a b (pred (h n)) (assocMaxO a b (pred (h n))))
        else
          refl)) ⟩
    limit (λ n → maxO (succ a) (maxO (succ b) (h n)))
  ≡⟨⟩
    maxO (succ a) (maxO (succ b) (limit h))
  ∎
  where
    isSucc : ∀ {ℓ} → Ordinal ℓ → Bool
    isSucc zero = false
    isSucc (succ _) = true
    isSucc (limit _) = false
    
    pred : ∀ {ℓ} → Ordinal ℓ → Ordinal ℓ
    pred zero = zero
    pred (succ x) = x
    pred (limit f) = limit (λ n → pred (f n))

-- שאר המקרים עם limit
assocMaxO (succ a) (limit g) (succ c) = assocMaxO-complex (succ a) (limit g) (succ c)
assocMaxO (limit f) (succ b) (succ c) = assocMaxO-complex (limit f) (succ b) (succ c)
assocMaxO (limit f) (limit g) (succ c) = assocMaxO-complex (limit f) (limit g) (succ c)

-- הוספנו גם את האסוציאטיביות החשובה על מקסימום של אורדינלים
-- (שימושי לקרדינלים: aleph α ⊕ aleph β)
commMaxO : ∀ {ℓ} (a b : Ordinal ℓ) → maxO a b ≡ maxO b a
commMaxO zero zero = refl
commMaxO zero (succ b) = refl
commMaxO zero (limit g) = refl
commMaxO (succ a) zero = refl
commMaxO (succ a) (succ b) = cong succ (commMaxO a b)
commMaxO (limit f) zero = refl
commMaxO (limit f) (limit g) = cong limit (funExt (λ n → commMaxO (f n) (g n)))
commMaxO (succ a) (limit g) = cong limit (funExt (λ n → commMaxO (succ a) (g n)))
commMaxO (limit f) (succ b) = cong limit (funExt (λ n → commMaxO (f n) (succ b)))

-- למת עזר: חוק קיבוצי (אסוציאטיבי) על מקרים עם zero
maxZeroAssoc : ∀ {ℓ} (a b : Ordinal ℓ) → maxO (maxO zero a) b ≡ maxO zero (maxO a b)
maxZeroAssoc a b = refl

-- למת עזר: במקרה של succ, אפשר להוציא את ה-succ החוצה משני הצדדים
maxSuccAssoc : ∀ {ℓ} (a b c : Ordinal ℓ) → maxO (maxO a b) c ≡ maxO a (maxO b c) → maxO (maxO (succ a) (succ b)) (succ c) ≡ maxO (succ a) (maxO (succ b) (succ c))
maxSuccAssoc a b c eq = cong succ eq

-- למות עזר למקרים עם לפחות אחד הארגומנטים הוא zero
maxZeroLeft : ∀ {ℓ} (a : Ordinal ℓ) → maxO zero a ≡ a
maxZeroLeft a = refl

maxZeroRight : ∀ {ℓ} (a : Ordinal ℓ) → maxO a zero ≡ a
maxZeroRight zero = refl
maxZeroRight (succ a) = refl
maxZeroRight (limit f) = refl

-- קומוטטיביות של natTo
commNatTo : ∀ {ℓ} (n : ℕ) (α β : Ordinal ℓ) → natTo n α β ≡ natTo n β α
commNatTo n α β = cong (λ x → maxO (fromNatO n) x) (commMaxO α β)

-- אסוציאטיביות של natTo עם limit′
assocNatTo : ∀ {ℓ} (n : ℕ) (α β γ : Ordinal ℓ) → 
             natTo n (limit′ (λ m → natTo m α β)) γ ≡ natTo n α (limit′ (λ m → natTo m β γ))
assocNatTo n α β γ = 
  cong (λ x → maxO (fromNatO n) x) (limitNatToAssoc α β γ)
          
-- | Lemma: limit preserves order
limit≤limit : ∀ {ℓ} {f g : ℕ → Ordinal ℓ} → (∀ n → f n ≤ g n) → limit f ≤ limit g
limit≤limit {f = f} {g} f≤g = supL proof
  where
    -- We need to show: ∀ m → f m ≤ limit g
    proof : ∀ m → f m ≤ limit g
    proof m = supR (m , f≤g m)

-- | הוכחה שהחיבור מונוטוני מימין
-- | (אם x ≤ y אז z + x ≤ z + y)
monoRplus : ∀ {ℓ} (x y z : Ordinal ℓ) → x ≤ y → (z + x) ≤ (z + y)
-- Induction on z
-- Case z = zero
monoRplus x y zero x≤y = x≤y
-- Case z = succ z'
monoRplus x y (succ z') x≤y = suc≤ (monoRplus x y z' x≤y)
-- Case z = limit h
-- Goal: limit (λ n → h n + x) ≤ limit (λ n → h n + y)
-- IH: ∀ n → monoRplus x y (h n) x≤y which is ∀ n → (h n + x) ≤ (h n + y)
monoRplus x y (limit h) x≤y = limit≤limit (λ n → monoRplus x y (h n) x≤y)

-- | הוכחה שהכפל מונוטוני מימין
-- | (אם b ≤ c אז a * b ≤ a * c)
mono* : ∀ {ℓ} (a b c : Ordinal ℓ) → b ≤ c → (a * b) ≤ (a * c)
-- Induction on a
-- Case a = zero
-- Goal: zero * b ≤ zero * c. LHS=zero, RHS=zero. So zero ≤ zero, proven by zero≤.
mono* zero b c b≤c = zero≤
-- Case a = succ a'
-- Goal: (succ a * b) ≤ (succ a * c)  which is  b + (a * b) ≤ c + (a * c)
-- IH: mono* a b c b≤c  gives  (a * b) ≤ (a * c)
mono* (succ a) b c b≤c = +-mono b c (a * b) (a * c) b≤c (mono* a b c b≤c)
-- Case a = limit f
-- Goal: limit f * b ≤ limit f * c  which is  limit (λ n → f n * b) ≤ limit (λ n → f n * c)
-- IH: ∀ n → mono* (f n) b c b≤c  gives  (f n * b) ≤ (f n * c)
mono* (limit f) b c b≤c = limit≤limit (λ n → mono* (f n) b c b≤c)

-- | מונוטוניות של חיבור (צד ימין)
mono⁺ʳ : ∀ {ℓ} (a b c : Ordinal ℓ) → b ≤ c → (a + b) ≤ (a + c)
mono⁺ʳ zero b c b≤c = b≤c
mono⁺ʳ (succ a) b c b≤c = suc≤ (mono⁺ʳ a b c b≤c)
mono⁺ʳ (limit f) b c b≤c = supL (λ n → mono⁺ʳ (f n) b c b≤c)

-- | מונוטוניות של כפל (צד שמאל)
monoL* : ∀ {ℓ} (a b c : Ordinal ℓ) → a ≤ b → (a * c) ≤ (b * c)
monoL* zero b c a≤b = zero≤
monoL* (succ a) (succ b) c (suc≤ a≤b) = 
  let
    -- (succ a) * c = c + (a * c)
    -- (succ b) * c = c + (b * c)
    -- צריך להוכיח: c + (a * c) ≤ c + (b * c)
    IH = monoL* a b c a≤b -- הנחת האינדוקציה: (a * c) ≤ (b * c)
  in mono⁺ʳ c (a * c) (b * c) IH -- מונוטוניות חיבור מימין
monoL* (limit f) b c (supL ∀n→fn≤b) = 
  supL (λ n → trans≤ (monoL* (f n) b c (∀n→fn≤b n)) {!!})  -- צריך למלא
monoL* a (limit g) c (supR (n , a≤gn)) = 
  trans≤ (monoL* a (g n) c a≤gn) {!!}  -- צריך למלא
-- מקרים נוספים - ניתן להשלים באמצעות פוסטולט
monoL* a b c _ = {!!}

                                                  