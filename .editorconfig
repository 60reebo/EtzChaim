root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.agda]
indent_style = space
indent_size = 2
charset = utf-8

[*.hs]
indent_style = space
indent_size = 2
charset = utf-8

[*.md]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = false

[*.json]
indent_style = space
indent_size = 2
charset = utf-8

[*.yml]
indent_style = space
indent_size = 2
charset = utf-8

[*.yaml]
indent_style = space
indent_size = 2
charset = utf-8
