cabal-version:       2.4
name:                etzchaim
version:             0.1.0
build-type:          Simple

library
  exposed-modules:    
  hs-source-dirs:     src
  build-depends:      base >=4.7 && <5, text
  default-language:   Haskell2010

executable etzchaim
  main-is:            Main.hs
  hs-source-dirs:     . src
  other-modules:      Hishtalshelut.Runtime.Simulation
  build-depends:      base >=4.7 && <5, text, containers, directory, optparse-applicative
  ghc-options:        -O2
  default-language:   Haskell2010

test-suite etzchaim-test
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test src
  main-is:            MainSpec.hs
  other-modules:      DomainSpec, PropSpec
  build-depends:      base >=4.7 && <5, text, hspec >=2.0, QuickCheck >=2.14
  default-language:   Haskell2010

benchmark etzchaim-bench
  type:               exitcode-stdio-1.0
  hs-source-dirs:     bench src
  main-is:            Bench.hs
  build-depends:      base >=4.7 && <5, criterion >=1.5, text
  default-language:   Haskell2010
  ghc-options:        -O2 -threaded -rtsopts -with-rtsopts=-N